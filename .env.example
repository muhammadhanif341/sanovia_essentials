# Copy to .env.local and adjust. Only VITE_-prefixed vars reach the browser.

# WhatsApp business number, digits only, international format, no "+".
# Default in code is the number shown on the Instagram profile — confirm it.
VITE_WHATSAPP_NUMBER=923286097302

# Canonical origin (used to build absolute product links inside WhatsApp messages).
VITE_SITE_URL=http://localhost:5173

# Display currency for prices. Confirm with the client.
VITE_CURRENCY=PKR

# Payments (see src/services/paymentService.js). Leave unset/false in every environment
# until a real gateway provider is registered in LIVE_PROVIDERS there — Card and Digital
# Wallet checkout otherwise run through a clearly-labelled, no-op TEST simulation. Cash on
# Delivery needs no gateway and works for real regardless of this flag.
VITE_PAYMENTS_LIVE=false
